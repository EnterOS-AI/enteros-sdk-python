# Code generated by tools/gen-registry.mjs — DO NOT EDIT.
# Source of truth: contracts/registry.yaml. Regenerate with:
#   node tools/gen-registry.mjs
#
# `source` this fragment (or read it with a KEY=VALUE parser) to derive every
# registry reference from the ONE SSOT. Both seams below carry the SAME prefix:
#   MOLECULE_IMAGE_REGISTRY — the Go runtime override (CP + core RegistryPrefix)
#   MOLECULE_REGISTRY       — the CI publisher IMAGE_NAME derivation var

MOLECULE_REGISTRY_PREFIX=registry.moleculesai.app/molecule-ai
MOLECULE_REGISTRY_HOST=registry.moleculesai.app
MOLECULE_REGISTRY_OWNER=molecule-ai
MOLECULE_REGISTRY_PUSH_HOST=localhost:3200
MOLECULE_REGISTRY_AUTH_KIND=basic
MOLECULE_REGISTRY_USERNAME_ENV=GITEA_USER
MOLECULE_REGISTRY_PASSWORD_ENV=GITEA_TOKEN

# The two derivation seams — both default to the canonical prefix. A deploy
# or CI run overrides EITHER to switch registries with no code edit.
MOLECULE_IMAGE_REGISTRY=registry.moleculesai.app/molecule-ai
MOLECULE_REGISTRY=registry.moleculesai.app/molecule-ai

# Retention (enforced by operator-config/ops/registry-retention-prune.sh).
MOLECULE_REGISTRY_KEEP_MAX_VERSIONS=5
MOLECULE_REGISTRY_KEEP_TAGS=latest,stable,release,prod-*,staging-*,*-kernel,keep-*,migrated-*,v1
MOLECULE_REGISTRY_PIN_SOURCE=tag-keep-list (operator-config/etc/registry-retention.conf) + structural OCI-index digest refs
